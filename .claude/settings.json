{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "switchModelsOnFlag": false,
  "permissions": {
    "allow": [
      "Bash(tools/card.sh *)",
      "Bash(./tools/card.sh *)",
      "Bash(npm run check)",
      "Bash(cp .runs/ledger.jsonl docs/agent-runs.jsonl)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(opencode session list *)",
      "Bash(opencode export *)",
      "Bash(opencode stats *)",
      "Bash(opencode agent list)",
      "Bash(telnyx-edge list *)",
      "Bash(telnyx-edge logs *)",
      "Bash(jq *)",
      "Edit(/.runs/**)",
      "Edit(/docs/**)",
      "Edit(/tasks/**)",
      "Edit(/DOGFOODING.md)",
      "Edit(/DEBUGLOG.md)"
    ],
    "ask": [
      "Bash(tools/card.sh * --check *)",
      "Bash(./tools/card.sh * --check *)",
      "Edit(/AGENTS.md)",
      "Edit(/.opencode/**)",
      "Edit(/.claude/**)",
      "Bash(opencode run *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Edit(/functions/**)",
      "Edit(/packages/**)",
      "Edit(/assistant/**)",
      "Edit(/scripts/**)",
      "Edit(/spikes/**)",
      "Edit(/infra/**)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/tsconfig*.json)",
      "Edit(/vitest.config.*)",
      "Bash(telnyx-edge ship *)",
      "Bash(telnyx-edge secrets *)",
      "Bash(git push *)",
      "Read(~/.config/telnyx/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
